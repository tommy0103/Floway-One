{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floway",
  "version": "0.1.0",
  "identifier": "dev.floway.one",
  "build": {
    "beforeBuildCommand": "pnpm run prepare:bundle",
    "frontendDist": "bundle-inputs/runtime/apps/web/dist/client"
  },
  "app": {
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.generated.png"
